# code-analyzer 环境变量配置示例
# 使用：复制本文件为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会上传到 Git）

# API key（应用于已有模型的 provider；CLI --base-url 自定义模式也会读取）
# CLI --api-key 优先于此值；--api-key= 可显式使用无鉴权本地服务
CODE_ANALYZER_API_KEY=

# 模型选择：provider/modelId 或 modelId
# 例：deepseek/deepseek-v4-pro
# CLI 显式 --base-url 时，此值用作接口接受的完整模型名（包含 / 也不拆分）
CODE_ANALYZER_MODEL=

# （可选）覆盖已有模型 provider 的 API base URL，默认使用模型内置的地址
# 此变量不启用自定义模式；自定义 OpenAI Chat Completions 接口请用 CLI --base-url
# --base-url 填 API 根路径（通常 /v1），不要包含 /chat/completions
# 例：https://api.deepseek.com
# CODE_ANALYZER_BASE_URL=

# HTTP llm 对象不会读取上述 key，需由请求明确提供（省略表示无鉴权）
