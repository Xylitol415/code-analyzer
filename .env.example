# code-analyzer 环境变量配置示例
# 使用：复制本文件为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会上传到 Git）

# API key（应用于所选模型的 provider）
CODE_ANALYZER_API_KEY=

# 模型选择：provider/modelId 或 modelId
# 例：deepseek/deepseek-v4-pro
CODE_ANALYZER_MODEL=

# （可选）覆盖 API base URL，默认使用模型内置的地址
# 例：https://api.deepseek.com
# CODE_ANALYZER_BASE_URL=
