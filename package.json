  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@hono/node-server": "^2.1.5",
    "dotenv": "^18.0.8",
    "hono": "^4.13.13",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
