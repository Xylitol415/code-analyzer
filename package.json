{
  "name": "code-analyzer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read-only AI assistant for analyzing git project code logic, built on the pi SDK",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --import tsx --import ./tests/test-env.ts --test --test-concurrency=4 tests/*.test.ts",
    "start": "tsx src/main.ts",
    "serve": "tsx src/server.ts",
    "memory:evaluate": "node --import tsx scripts/memory-evaluate.ts",
    "memory:benchmark": "node --import tsx scripts/memory-benchmark.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@hono/node-server": "^2.1.5",
    "dotenv": "^18.0.8",
    "hono": "^4.13.13",
    "ipaddr.js": "^2.5.0",
    "proper-lockfile": "^4.1.2",
    "typebox": "1.3.27",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/yauzl": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "optionalDependencies": {
    "@zvec/zvec": "0.7.1"
  }
}
